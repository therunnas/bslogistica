# Configuração pública do Supabase. As duas são públicas por natureza: viajam
# no JavaScript da página. Quem protege os dados é a RLS do banco. A chave
# secreta (service_role) não é usada por esta aplicação e não deve entrar aqui
# nem em nenhuma variável NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Segredo server-only que assina a prova de recuperação de senha (HMAC-SHA-256).
# Emitida em /auth/confirm depois do verifyOtp e conferida em /redefinir-senha.
# Nunca use o prefixo NEXT_PUBLIC_ aqui: ele embutiria o valor no bundle do
# navegador e qualquer pessoa poderia forjar a prova. Gere pelo menos 32 bytes
# aleatórios em produção. Ausente em runtime, o fluxo falha fechado.
PASSWORD_RECOVERY_PROOF_SECRET=<oculto>
