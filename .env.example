# Configuração pública do Supabase. Todas estas variáveis são públicas por
# natureza: viajam no JavaScript da página. Quem protege os dados é a RLS do
# banco. A chave secreta (service_role) não é usada por esta aplicação e não
# deve entrar aqui nem em nenhuma variável NEXT_PUBLIC_ ou VITE_.

# Next.js (src/app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TanStack/Vite (src/routes) — sai quando a migração terminar
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
