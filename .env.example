# Configuração pública do Supabase. As duas são públicas por natureza: viajam
# no JavaScript da página. Quem protege os dados é a RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (service_role), server-only. Usada apenas por
# src/integrations/supabase/admin.ts, e só a partir do PR D (backend
# administrativo de usuários): listar/convidar contas pela Admin API e
# escrever em user_roles, que não tem policy de escrita para `authenticated`.
# NUNCA use o prefixo NEXT_PUBLIC_ aqui — o prefixo embute o valor no bundle do
# navegador, e esta chave ignora RLS. Nunca importar admin.ts de um componente
# client. Copie do painel do Supabase (Project Settings → API); ausente em
# runtime, toda operação administrativa falha fechada.
SUPABASE_SERVICE_ROLE_KEY=<oculto>

# Segredo server-only que assina a prova de recuperação de senha (HMAC-SHA-256).
# Emitida em /auth/confirm depois do verifyOtp e conferida em /redefinir-senha.
# Nunca use o prefixo NEXT_PUBLIC_ aqui: ele embutiria o valor no bundle do
# navegador e qualquer pessoa poderia forjar a prova. Gere pelo menos 32 bytes
# aleatórios em produção. Ausente em runtime, o fluxo falha fechado.
PASSWORD_RECOVERY_PROOF_SECRET=<oculto>

# Trava de servidor da ativação do motor financeiro por vigência (C05-B8.12). Server-only: nunca
# use o prefixo NEXT_PUBLIC_. Só o texto exato "true" abre a janela de ativação; ausente (o
# padrão, em todos os ambientes, Production inclusive), vazio ou qualquer outro valor, a Server
# Action recusa. Não deixe ligada: abra para a ativação autorizada, ligue o motor pela tela
# /implantacao-vigencias (administrador com segundo fator) e remova a variável em seguida.
# BS_ATIVACAO_MOTOR_HABILITADA=true
